# ==============================================================================
# NOVA WHATSAPP BOT - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. GOOGLE GEMINI API (Wajib)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model utama yang digunakan (default: gemini-flash-lite-latest — cepat & hemat token harian)
# Otomatis failover ke: gemini-3.8-flash -> gemini-3.7-flash -> gemini-flash-latest -> gemini-3.5-flash-lite -> gemini-3.5-flash
GEMINI_MODEL=gemini-flash-lite-latest

# 2. KONFIGURASI WHATSAPP PAIRING CODE
# Nomor WhatsApp bot format internasional tanpa '+' atau spasi (contoh: 6281234567890)
# Jika dikosongkan saat terminal interaktif (SSH), bot akan meminta input nomor saat pertama kali pairing.
WA_PHONE_NUMBER=6281234567890

# Direktori penyimpanan sesi login WhatsApp (relatif terhadap folder whatsapp-bot atau path absolut)
WA_AUTH_DIR=auth_info

# 3. PERILAKU CHATBOT & KEAMANAN
# Nama bot yang ditampilkan di sapaan / status
BOT_NAME=NOVA

# Tanda tangan / footer di bawah setiap balasan otomatis AI (kosongkan jika tidak ingin ditampilkan)
BOT_FOOTER=_— Dibalas otomatis oleh NOVA AI_

# Awalan perintah khusus (!help, !reset, !status, !ai)
BOT_PREFIX=!

# Mode respon di grup WhatsApp:
# - off     : abaikan semua pesan grup
# - mention : balas hanya jika bot di-mention, di-reply, atau dipanggil dengan prefix (!ai / !nova)
# - all     : balas semua pesan teks di grup
GROUP_MODE=mention

# Abaikan chat / grup yang diarsipkan di WhatsApp (true = jangan dibalas, false = tetap dibalas)
IGNORE_ARCHIVED=true

# Whitelist nomor yang boleh memakai bot (pisahkan dengan koma, kosongkan untuk mengizinkan semua)
# Contoh: ALLOWED_NUMBERS=6281234567890,6289876543210
ALLOWED_NUMBERS=

# Jumlah maksimum pesan riwayat percakapan yang dikirim ke AI sebagai konteks (2 - 30, default 10 agar hemat token)
MAX_HISTORY_MESSAGES=10

# Jeda anti-spam per chat dalam milidetik
COOLDOWN_MS=1500

# 4. MONITORING & LOGGING VPS
# Port HTTP untuk endpoint /health (0 = nonaktif, contoh: 3001 jika ingin dipantau Uptime/Docker)
HEALTH_PORT=0

# Level log Baileys (silent, error, warn, info, debug)
LOG_LEVEL=silent

# 5. DATABASE RIWAYAT PERCAKAPAN (Opsional — sama dengan web chatbot NOVA)
# Isi TURSO_DATABASE_URL & TURSO_AUTH_TOKEN jika ingin sinkron ke Turso Cloud.
# Jika dikosongkan, bot memakai SQLite lokal (.tmp/nova_whatsapp.db) atau JSON fallback di Node 20.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SQLITE_DB_PATH=
